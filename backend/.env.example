# Backend environment variables. Copy to .env and fill in.
#
#   cp .env.example .env
#
# All of these are required — src/config/validate-env.js throws at startup
# listing every missing one, so the server never runs half-configured.

# Must be 3000 for local dev: frontend/.env.local points VITE_API_URL at
# http://localhost:3000, while config.PORT would otherwise default to 5000.
PORT=3000

# Any long random strings. Generate with: openssl rand -hex 32
JWT_SECRET=
CSRF_SECRET=

# Local Postgres (see README). NODE_ENV is unset in dev, so db.js uses the plain
# pg driver — no Neon account needed to run locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/purrsuit

# Must match the Vite dev origin exactly — CORS is configured from this value.
FRONTEND_URL=http://localhost:5173

# Create your OWN OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with
# http://localhost:3000/auth/google/callback as an authorized redirect URI.
# Don't reuse the deployed app's client — see the README for why.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
